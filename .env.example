NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared with store_settings.action_secret. Required for payment confirmation.
APP_ACTION_SECRET=replace-with-a-long-random-string

# Set to false after Moolre keys are live.
ALLOW_DEMO_PAYMENTS=true

# Moolre — https://docs.moolre.com
MOOLRE_API_USER=
MOOLRE_API_PUBKEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_CALLBACK_SECRET=

# Resend — https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=TechVerse <onboarding@resend.dev>

# Taysend — https://taysend.com/developers
TAYSEND_API_KEY=
TAYSEND_SENDER_ID=TECHVERSE
